<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>❤️ Ola ❤️</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600&display=swap" rel="stylesheet">

<style>

*{box-sizing:border-box;}

body{
    margin:0;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    font-family:'Poppins', sans-serif;
    background:radial-gradient(circle at top,#ff8fb1,#ff4d6d);
    overflow:hidden;
}

/* CARD */

.card{
    backdrop-filter:blur(18px);
    background:rgba(255,255,255,0.15);
    border-radius:35px;
    padding:50px;
    text-align:center;
    color:white;
    box-shadow:0 30px 80px rgba(0,0,0,.35);
    animation:fade 1s ease;
    max-width:90%;
}

h1{
    font-size:38px;
    min-height:90px;
}

/* BUTTONS */

button{
    border:none;
    padding:16px 34px;
    border-radius:16px;
    font-size:18px;
    cursor:pointer;
    transition:.25s;
}

#yes{
    background:white;
    color:#ff4d6d;
    font-weight:600;
    box-shadow:0 10px 30px rgba(255,255,255,.5);
}

#no{
    position:absolute;
    background:#222;
    color:white;
}

#counter{
    margin-top:20px;
    font-size:14px;
}

/* FLOATING HEARTS */

.heart{
    position:absolute;
    bottom:-40px;
    animation:float linear infinite;
}

@keyframes float{
    to{
        transform:translateY(-120vh);
        opacity:0;
    }
}

@keyframes fade{
    from{opacity:0; transform:scale(.7);}
    to{opacity:1; transform:scale(1);}
}

/* SUCCESS SCREEN */

.success{
    position:absolute;
    inset:0;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    color:white;
    animation:fade .8s ease;
}

/* BLURRED BACKGROUND IMAGE */

.bg{
    position:absolute;
    inset:0;
    background:url("zdjecie.jpg") center/cover;
    filter:blur(25px) brightness(0.6);
    transform:scale(1.2);
}

/* SHARP IMAGE */

.mainPhoto{
    max-width:320px;
    border-radius:30px;
    box-shadow:0 25px 70px rgba(0,0,0,.6);
    animation:photoIn 1.4s ease;
}

@keyframes photoIn{
    from{
        opacity:0;
        transform:scale(.6) rotate(-8deg);
    }
    to{
        opacity:1;
        transform:scale(1) rotate(0);
    }
}

/* CONFETTI */

.confetti{
    position:absolute;
    width:12px;
    height:12px;
    top:-20px;
    animation:fall linear forwards;
}

@keyframes fall{
    to{
        transform:translateY(110vh) rotate(720deg);
    }
}

.loveText{
    font-size:28px;
    margin-top:20px;
    font-weight:300;
    letter-spacing:2px;
}

.bigYes{
    font-size:60px;
    font-weight:600;
}

</style>
</head>
<body>

<div class="card">

<h1 id="typing"></h1>

<button id="yes">TAK 😍</button>
<button id="no">nie 😢</button>

<div id="counter">Próby kliknięcia NIE: 0</div>

</div>

<script>

//////////////// TYPEWRITER

const text="Ola... zostaniesz moją walentynką? ❤️";
let i=0;

function type(){
    if(i<text.length){
        document.getElementById("typing").innerHTML+=text.charAt(i);
        i++;
        setTimeout(type,45);
    }
}

type();

//////////////// HEARTS

function heart(){
    const h=document.createElement("div");
    h.classList.add("heart");
    h.innerHTML="❤️";

    h.style.left=Math.random()*100+"vw";
    h.style.fontSize=(Math.random()*30+20)+"px";
    h.style.animationDuration=(Math.random()*4+4)+"s";

    document.body.appendChild(h);
    setTimeout(()=>h.remove(),8000);
}

setInterval(heart,220);

//////////////// RUNAWAY BUTTON

const no=document.getElementById("no");
const yes=document.getElementById("yes");

let counter=0;
let yesScale=1;

function move(){

    counter++;
    yesScale+=0.08;

    document.getElementById("counter").innerText=
        "Próby kliknięcia NIE: "+counter;

    yes.style.transform=`scale(${yesScale})`;

    const maxX=window.innerWidth-no.offsetWidth;
    const maxY=window.innerHeight-no.offsetHeight;

    no.style.left=Math.random()*maxX+"px";
    no.style.top=Math.random()*maxY+"px";

    if(navigator.vibrate){
        navigator.vibrate(30);
    }
}

no.addEventListener("mouseover",move);
no.addEventListener("touchstart",move);

//////////////// CONFETTI

function confetti(){

    for(let i=0;i<160;i++){

        const c=document.createElement("div");
        c.classList.add("confetti");

        c.style.left=Math.random()*100+"vw";
        c.style.background=`hsl(${Math.random()*360},100%,60%)`;
        c.style.animationDuration=(Math.random()*3+2)+"s";

        document.body.appendChild(c);
        setTimeout(()=>c.remove(),5000);
    }
}

//////////////// YES CLICK

yes.addEventListener("click",()=>{

    confetti();

    const screen=document.createElement("div");
    screen.classList.add("success");

    screen.innerHTML=`
        <div class="bg"></div>

        <div class="bigYes">ONA POWIEDZIAŁA TAK ❤️</div>

        <img src="zdjecie.jpg" class="mainPhoto">

        <div class="loveText">
        Patryk ❤️ Ola
        </div>
    `;

    document.body.appendChild(screen);

    if(navigator.vibrate){
        navigator.vibrate([200,100,200,100,400]);
    }
});

</script>
</body>
</html>
